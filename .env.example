# ============================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ============================================
VITE_API_URL=https://your-backend-api.com/api/v1

# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================

# Server Configuration
PORT=5000

# Database
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/database_name

# JWT Authentication
JWT_SECRET=your_long_jwt_secret_key_here_at_least_32_characters
JWT_EXPIRY=7d

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-domain.com

# Email Support
CONTACT_US_EMAIL=your-email@gmail.com

# Cloudinary (Image/Video Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_SECURE=true

# SMTP Configuration (Email Sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@yourapp.com

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_secret
RAZORPAY_PLAN_ID=your_razorpay_plan_id
